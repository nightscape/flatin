# Fastlane configuration for iOS
# Documentation: https://docs.fastlane.tools/getting-started/ios/setup/

default_platform(:ios)

require File.expand_path(File.join(File.dirname(__FILE__), "..", "..", "fastlane", "version_from_tag"))

def release_build_flags
  VersionFromTag.build_flags
rescue ArgumentError => e
  UI.user_error!(e.message)
end

platform :ios do
  desc "Build the iOS app"
  lane :build do
    sh("cd #{lane_context[:repository_root]} && flutter build ipa --release #{release_build_flags}")
  end

  desc "Upload to TestFlight (Beta Testing)"
  lane :beta do
    build
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false
    )
  end

  desc "Upload to App Store (Production)"
  lane :release do
    build
    upload_to_app_store(
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false
    )
  end
end

